{
  "name": "council-herdr",
  "version": "3.7.0",
  "description": "Run, schedule, and review agent workflows in Herdr Desktop, the Council CLI, and MCP.",
  "type": "module",
  "main": "bin/council.js",
  "bin": {
    "council": "bin/council.js"
  },
  "files": [
    "bin/",
    "lib/",
    "templates/",
    "skills/",
    "commands/",
    "rules/",
    "docs/",
    "PLAN.md",
    "herdr/install.js",
    "herdr/install-menu.js",
    "herdr/bridge.js",
    "herdr/RECIPE.md",
    "herdr/keys.json",
    "herdr/preview.png",
    "herdr/screenshots/",
    "herdr/mods/council/*.js",
    "herdr/mods/council/mod.json",
    "herdr/mods/council/icons/*.svg",
    "herdr/mods/council/runtime/*.mjs",
    "plugin.json",
    "mcp.json",
    "mcp_config.json",
    ".mcp.json",
    ".claude-plugin/",
    ".codex-plugin/"
  ],
  "scripts": {
    "test": "node --test",
    "doctor": "node bin/council.js doctor",
    "status": "node bin/council.js status",
    "mcp": "node bin/council.js mcp"
  },
  "keywords": [
    "herdr",
    "multi-agent",
    "council",
    "claude",
    "codex",
    "antigravity",
    "junie",
    "mcp",
    "ai-collaboration"
  ],
  "author": "Ejupi-Labs",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
